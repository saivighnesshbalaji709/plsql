-- Step 1: department/section this staff member belonged to AT THE TIME UMS-233378 was raised
SELECT xrht.req_number,
       xrht.req_date,
       papf.employee_number,
       papf.full_name,
       paaf.organization_id                AS org_id_at_req_date,
       haou.name                           AS section_at_req_date,
       (SELECT haou1.name
          FROM hr_all_organization_units haou1,
               per_org_structure_elements pose,
               per_organization_structures pos
         WHERE haou1.organization_id = pose.organization_id_parent
           AND pos.name = 'OA HQ Organization Hieararchy'
           AND pose.org_structure_version_id = pos.organization_structure_id
           AND pose.organization_id_child = paaf.organization_id) AS department_at_req_date
FROM xxum_request_header_tb xrht,
     per_all_people_f        papf,
     per_all_assignments_f   paaf,
     hr_all_organization_units haou
WHERE xrht.req_number = 'UMS-233378'
  AND papf.person_id = xrht.person_id
  AND papf.person_id = paaf.person_id
  AND TRUNC(xrht.req_date) BETWEEN papf.effective_start_date AND papf.effective_end_date
  AND TRUNC(xrht.req_date) BETWEEN paaf.effective_start_date AND paaf.effective_end_date
  AND papf.current_employee_flag = 'Y'
  AND paaf.primary_flag = 'Y'
  AND paaf.assignment_type = 'E'
  AND paaf.organization_id = haou.organization_id;
