	xxoa_create_update_time_entry.create_time_entry (
			p_person_id 	=> rec_atn_data.employee_id,
			p_punch_date	=> TO_CHAR(to_date (p_Attendance,'YYYY/MM/DD HH24:MI:SS')) ,--rec_atn_data.punch_date,
			p_time_in		=> p_Punch_In, --rec_atn_data.upd_time_in,
			p_time_out		=> P_punch_out, --rec_atn_data.upd_time_out,
			p_success		=> v_success,
			p_message		=> v_message,
			p_time_building_block_id => v_time_building_block_id);


	IF v_success = 'Y'
		THEN
			BEGIN
