		BEGIN

			   v_old_time_in := NULL;
			   v_old_time_out := NULL;
			   v_old_total_hours := NULL;

		select TIME_BUILDING_BLOCK_ID ,TIME_IN,TIME_OUT ,TOTAL_HOURS into v_time_building_block_id ,v_old_time_in,v_old_time_out,v_old_total_hours
		from XXOA_DETAIL_ATTENDANCE_V where
		employee_id =rec_atn_data.employee_id
		and PUNCH_DATE = v_attendance_date and rownum =1;

		EXCEPTION WHEN OTHERS
		THEN
			fnd_file.put_line (fnd_file.LOG,'Error in Fetching TIME_BUILDING_BLOCK_ID for SN :  '||rec_atn_data.EMPLOYEE_NUMBER);

		END;


	IF v_time_building_block_id is not NULL
	THEN
	fnd_file.put_line (fnd_file.LOG,'Start of Timecard Updation Block ! ');


		xxoa_create_update_time_entry.update_time_entry (
			p_person_id 	  => rec_atn_data.employee_id,
			p_bld_block_id   => v_time_building_block_id,
			p_punch_date	  => v_attendance_date,---TO_CHAR(to_date(p_Attendance,'YYYY/MM/DD HH24:MI:SS')), --rec_atn_data.punch_date,
			p_time_in		  => p_Punch_In ,
			p_time_out		  => P_punch_out ,
			p_success		  => v_success,
			p_message		  => v_message);

			fnd_file.put_line (fnd_file.LOG,'v_message ! '||v_message);

		IF v_success = 'Y'
		THEN
			BEGIN
				INSERT INTO xxoa_daily_attendance_history (employee_id,
																		 time_building_block_id,
																		 punch_date,
																		 time_in,
																		 time_out,
																		 total_hours,
																		 remarks,
																		 remark_desc,
																		 created_by,
																		 creation_date,
																		 last_update_login,
																		 last_updated_by,
																		 last_update_date)
					  VALUES (rec_atn_data.employee_id,
					  		 v_time_building_block_id,
                                v_attendance_date,
								 v_old_time_in,
								 v_old_time_out,
								 v_old_total_hours,
								 'Updated based on Line Manager Approval',
								 'Attendance updated through OTL Mass Update Program' ,
								 v_user_id,
								 SYSDATE,
								 v_login_id,
								 v_user_id,
								 SYSDATE);
			EXCEPTION WHEN OTHERS
            THEN
			 p_sts_flag := 'E';
			 fnd_file.put_line (fnd_file.LOG,'Failure history table insert For SN   - ' || rec_atn_data.employee_number||'  ' || SUBSTR(SQLERRM,1,240));
			END;

		ELSE
			 p_sts_flag := 'E';
              fnd_file.put_line (fnd_file.LOG,'Error For SN  - ' || rec_atn_data.employee_number || ' - ' || v_message);
		END IF;

	ELSE -----IF rec_atn_data.time_building_block_id is  NULL THEN

	fnd_file.put_line (fnd_file.LOG,'Timecard Details are not available for SN - ' || rec_atn_data.employee_number||' as on given date := '||v_attendance_date);

	/* fnd_file.put_line (fnd_file.LOG,'Start of Timecard Creation Block ! ');
