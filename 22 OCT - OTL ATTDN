																		 last_update_date)
					  VALUES (rec_atn_data.employee_id,
					  		 v_time_building_block_id,
							--rec_atn_data.punch_date,
                           TO_CHAR(to_date (p_Attendance,'YYYY/MM/DD HH24:MI:SS')),
                            p_Punch_In,
                            P_punch_out,
							--rec_atn_data.upd_time_in,
							--rec_atn_data.upd_time_out,
								 NULL,
								 NULL,
							rec_atn_data.remark,
							rec_atn_data.reason,
								v_user_id,
								 SYSDATE,
								 v_login_id,
								 v_user_id,
								 SYSDATE);
			EXCEPTION WHEN OTHERS
            THEN
			 p_sts_flag := 'E';
			 fnd_file.put_line (fnd_file.LOG,'Failure history table insert For SN   - ' || rec_atn_data.employee_number||'  person_analysis_id = '|| rec_atn_data.person_analysis_id || ' - ' || SUBSTR(SQLERRM,1,240));
			END;



		ELSE
			 p_sts_flag := 'E';
              fnd_file.put_line (fnd_file.LOG,'Error For Timecard Creation SN  - ' || rec_atn_data.employee_number || ' - ' || v_message);
		END IF;
		*/

	END IF;  ----END added for SR 400991


	 END Loop;

        IF nvl(p_sts_flag,'N') = 'E'
        THEN
        p_retcode := 1;
        END IF;

	 EXCEPTION
      WHEN OTHERS
      THEN
         fnd_file.put_line (fnd_file.LOG,
                            'Error In Main Program '|| SUBSTR(SQLERRM,1,100)
                           );

   END XXOA_OTL_ATTENDANCE_MASS_UPD;
