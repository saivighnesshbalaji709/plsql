                    write_xml ('<P_TO>' ||NVL(TO_CHAR(cp_to_date, 'DD-MON-RRRR'),'31-DEC-4712')|| '</P_TO>');
                    write_xml ('<P_ITEM>'|| '<![CDATA['|| l_item_name || ']]>' || '</P_ITEM>');
                     write_xml ('<SCATE>' ||  '<![CDATA[' ||l_staff_category || ']]>'  || '</SCATE>');

                  FOR rec_cur_item_dtl IN cur_item_details(cp_from_date, cp_to_date, p_item_code, p_staff_category)
                     LOOP
                          BEGIN
                            write_xml ('<G_DUE_ENT_RPT_HEADER_INFO2>');
                            write_xml('<S_NO>' || '<![CDATA[' ||rec_cur_item_dtl.staff_number|| ']]>' || '</S_NO>');
                            write_xml('<S_NAME>' || '<![CDATA[' ||rec_cur_item_dtl.staff_name|| ']]>' || '</S_NAME>');
                            write_xml('<DOJ>' || '<![CDATA[' ||rec_cur_item_dtl.date_of_joining|| ']]>' || '</DOJ>');
                            write_xml('<DEPT>' || '<![CDATA[' ||rec_cur_item_dtl.department|| ']]>' || '</DEPT>');
                            write_xml('<SEC>' || '<![CDATA[' ||rec_cur_item_dtl.section|| ']]>' || '</SEC>');
                            write_xml('<POS>' || '<![CDATA[' ||rec_cur_item_dtl.position|| ']]>' || '</POS>');
                            write_xml('<LOC>' || '<![CDATA[' ||rec_cur_item_dtl.location|| ']]>' || '</LOC>');
                            write_xml('<GRD>' || '<![CDATA[' ||rec_cur_item_dtl.grade|| ']]>' || '</GRD>');
                            write_xml('<SCAT>' || '<![CDATA[' ||rec_cur_item_dtl.staff_category|| ']]>' || '</SCAT>');
                            write_xml('<ICOD>' || '<![CDATA[' ||rec_cur_item_dtl.item_Code|| ']]>' || '</ICOD>');
                            write_xml('<IDES>' || '<![CDATA[' ||rec_cur_item_dtl.item_description|| ']]>' || '</IDES>');
							write_xml('<IPRIC>' || '<![CDATA[' ||rec_cur_item_dtl.unit_price|| ']]>' || '</IPRIC>');  -- added as per SR 377561
                            write_xml('<AVAI>' || '<![CDATA[' ||rec_cur_item_dtl.due_ent|| ']]>'|| '</AVAI>');
                            write_xml('<EXP>' || '<![CDATA[' ||rec_cur_item_dtl.due_date|| ']]>'|| '</EXP>');
							write_xml('<SIZE>' || '<![CDATA[' ||rec_cur_item_dtl.item_size|| ']]>'|| '</SIZE>');  --added as per SR 375753
                            write_xml ('</G_DUE_ENT_RPT_HEADER_INFO2>');
                      EXCEPTION WHEN OTHERS THEN
                         write_xml ('</G_DUE_ENT_RPT_HEADER_INFO2>');
                         write_log('ERROR IN XML TAGS'||' '||SQLERRM);
                     END;
                     END LOOP;
                   write_xml ('</G_DUE_ENT_RPT_HEADER_INFO1>');
               EXCEPTION WHEN OTHERS THEN
                 write_xml ('</G_DUE_ENT_RPT_HEADER_INFO1>');
                 write_log('ERROR IN XML TAGS'||' '||SQLERRM);
                 END XXUM_DUE_ENTITLEMENT_RPT_PRC;
 END XXUM_DUE_ENTITLEMENT_RPT_PKG;
